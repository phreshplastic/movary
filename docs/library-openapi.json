              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  },
                  "mediaType": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "interest": {
                    "type": "string"
                  },
                  "reaction": {
                    "type": "string"
                  },
                  "genre": {
                    "type": "string"
                  },
                  "person": {
                    "type": "string"
                  },
                  "language": {
                    "type": "string"
                  },
                  "country": {
                    "type": "string"
                  },
                  "keyword": {
                    "type": "string"
                  },
                  "year": {
                    "type": "string"
                  },
                  "sort": {
                    "type": "string"
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100,
                    "default": 25
                  },
                  "offset": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 0
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Versioned personal-library result. Search and history use total, limit, offset, nextOffset, and items; title credits and taste have separate pagination. Preview returns exact changes, id, revision, and approval; commit returns the durable receipt.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "302": {
            "description": "Sign-in required"
          },
          "400": {
            "description": "Invalid, expired, stale, or temporarily unavailable operation; personal records are preserved"
          },
          "403": {
            "description": "Invalid CSRF token"
          }
        }
      }
    },
