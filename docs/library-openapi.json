{
  "openapi": "3.0.2",
  "info": {
    "title": "Private personal-library browser API",
    "version": "1.0",
    "description": "Same-origin browser adapter for the shared personal-record service. Existing web login and CSRF are required, including read POSTs. MCP uses the STDIO adapter, not an unauthenticated HTTP endpoint."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/library-api/context": {
      "post": {
        "summary": "Context",
        "parameters": [
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "tasteOffset": {
                    "type": "integer"
                  },
                  "fullStatements": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Versioned personal-library result. Search and history use total, limit, offset, nextOffset, and items; title credits and taste have separate pagination. Preview returns exact changes, id, revision, and approval; commit returns the durable receipt.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "302": {
            "description": "Sign-in required"
          },
          "400": {
            "description": "Invalid, expired, stale, or temporarily unavailable operation; personal records are preserved"
          },
          "403": {
            "description": "Invalid CSRF token"
          }
        }
      }
    },
