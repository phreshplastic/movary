  "components": {
    "securitySchemes": {
      "webSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "id"
      },
      "csrfCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "csrf"
      }
    },
    "schemas": {
      "PersonalChange": {
        "type": "object",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "log_watch",
              "edit_assessment",
              "confirm_seen",
              "set_interest",
              "set_status",
              "set_progress",
              "resolve_identity",
              "save_taste"
            ]
          },
          "titleId": {
            "type": "string"
          },
          "mediaType": {
            "type": "string"
          },
          "reaction": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "interest": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "progress": {
            "type": "string"
          },
          "tasteId": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "tmdbId": {
            "type": "integer"
          },
          "date": {
            "type": "string",
            "nullable": true,
            "format": "date"
          },
          "season": {
            "type": "integer",
            "nullable": true
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "security": [
    {
      "webSession": [],
      "csrfCookie": []
    }
  ]
