<nav class="navbar app-navbar" aria-label="Main navigation">
    <div class="container">
        <a class="navbar-brand" href="{{ applicationUrl }}{{ loggedIn ? '/library' : '/' }}" id="navbarBrand">Watch library</a>
        <div class="app-nav-actions">
            {% if loggedIn %}
                <a class="btn btn-primary" href="{{ applicationUrl }}/add-watched" {% if requestUrlPath in ['/add-watched', '/journal'] %}aria-current="page"{% endif %}><i class="bi bi-plus-lg" aria-hidden="true"></i> Add watched</a>
            {% endif %}
            <div class="dropdown">
                <button type="button" class="btn btn-outline-secondary" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Settings"><i class="bi bi-gear" aria-hidden="true"></i><span class="d-none d-sm-inline"> Settings</span></button>
                <ul class="dropdown-menu dropdown-menu-end">
                    {% if loggedIn %}
                        <li><a class="dropdown-item" href="{{ applicationUrl }}/settings/account/general">Settings</a></li>
                        <li><a class="dropdown-item" href="{{ applicationUrl }}/users/{{ currentUserName }}">Advanced movie tools</a></li>
                        <li><hr class="dropdown-divider"></li>
                    {% else %}
                        <li><a class="dropdown-item" href="{{ applicationUrl }}/login">Sign in</a></li>
                    {% endif %}
                    <li><div class="form-check form-switch mx-3 my-2">
                        <input class="form-check-input" type="checkbox" onclick="toggleThemeSwitch()" role="switch" id="darkModeInput">
                        <label class="form-check-label" for="darkModeInput">Dark mode</label>
                    </div></li>
                    {% if loggedIn %}
                        <li><hr class="dropdown-divider"></li>
                        <li><button class="dropdown-item" onclick="logout()">Sign out</button></li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </div>
</nav>
<hr class="d-none" id="darkModeNavHr">
