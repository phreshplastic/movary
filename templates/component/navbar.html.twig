<nav class="navbar app-navbar" aria-label="Main navigation">
    <div class="container">
        <a class="navbar-brand" href="{{ applicationUrl }}{{ loggedIn ? '/library' : '/' }}" id="navbarBrand">Movies &amp; TV</a>
        {% if loggedIn %}
        <div class="library-navigation">
            <a href="{{ applicationUrl }}/library" {% if requestUrlPath == '/library' %}aria-current="page"{% endif %}>Library</a>
            <a href="{{ applicationUrl }}/watchlist" {% if requestUrlPath == '/watchlist' %}aria-current="page"{% endif %}>Wishlist</a>
            <a href="{{ applicationUrl }}/taste" {% if requestUrlPath == '/taste' %}aria-current="page"{% endif %}>Taste</a>
        </div>
        {% endif %}
        <div class="app-nav-actions">
            {% if loggedIn %}<a class="btn btn-primary" href="{{ applicationUrl }}/log-watch"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add</a>{% endif %}
            <div class="dropdown">
                <button type="button" class="btn btn-outline-secondary nav-settings" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Settings"><i class="bi bi-gear" aria-hidden="true"></i></button>
                <ul class="dropdown-menu dropdown-menu-end">
                    {% if loggedIn %}
                        <li><a class="dropdown-item" href="{{ applicationUrl }}/settings/account/general">Settings</a></li>
                        <li><a class="dropdown-item" href="{{ applicationUrl }}/browse-history">Browse titles</a></li>
                        <li><a class="dropdown-item" href="{{ applicationUrl }}/watchlist?interest=not_interested">Not interested</a></li>
                        <li><a class="dropdown-item" href="{{ applicationUrl }}/import-history">Import history</a></li>
                        <li><a class="dropdown-item" href="{{ applicationUrl }}/journal/export/context">Export Markdown</a></li>
                        <li><a class="dropdown-item" href="{{ applicationUrl }}/journal/export/csv">Export CSV</a></li>
                        <li><a class="dropdown-item" href="{{ applicationUrl }}/journal/export/json">Export full library (JSON)</a></li>
                        <li><hr class="dropdown-divider"></li>
                    {% else %}<li><a class="dropdown-item" href="{{ applicationUrl }}/login">Sign in</a></li>{% endif %}
                    <li><div class="form-check form-switch mx-3 my-2"><input class="form-check-input" type="checkbox" onclick="toggleThemeSwitch()" role="switch" id="darkModeInput"><label class="form-check-label" for="darkModeInput">Dark mode</label></div></li>
                    {% if loggedIn %}<li><hr class="dropdown-divider"></li><li><button class="dropdown-item" onclick="logout()">Sign out</button></li>{% endif %}
                </ul>
            </div>
        </div>
    </div>
</nav>
<hr class="d-none" id="darkModeNavHr">
